# =====================================================================
#  Modèle de configuration de PRODUCTION
#
#  Sur le serveur de prod :
#    cp .env.local.dist .env.local
#    # renseigner les valeurs ci-dessous, puis :
#    make deploy
#
#  Le fichier .env.local (avec les vraies valeurs) NE DOIT PAS être
#  commité — il est ignoré par .gitignore. Ce modèle-ci, lui, l'est
#  et ne contient donc aucun secret : que des valeurs à remplacer.
# =====================================================================

# Environnement d'exécution
APP_ENV=prod

# Clé secrète de l'application — générer une valeur unique :
#   php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
# Ne PAS laisser vide : elle signe les jetons CSRF et les cookies de session
# « rester connecté » du back-office.
APP_SECRET=

###> Base de données PostgreSQL ###
#  Préparation du serveur, une fois pour toutes (en root) :
#    sudo -u postgres psql -c "CREATE ROLE giulia LOGIN PASSWORD '<motdepasse>';"
#    sudo -u postgres createdb -O giulia giulia
#
#  Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE?serverVersion=XX&charset=utf8
#    - `serverVersion` DOIT correspondre au PostgreSQL du serveur : DBAL s'en sert
#      pour adapter le SQL généré. Le vérifier avec :
#        sudo -u postgres psql -tAc "show server_version"
#    - encoder les caractères spéciaux du mot de passe :
#      @ → %40 · # → %23 · : → %3A · / → %2F · $ → %24 · espace → %20
#
#  Les migrations sont appliquées par `make deploy` (cible `db`).
#
#  Sauvegarde recommandée — ligne de crontab (le % y doit être échappé en \%) :
#    0 4 * * * pg_dump -Fc giulia > /chemin/sauvegardes/giulia-$(date +\%F).dump
DATABASE_URL="postgresql://giulia:MOTDEPASSE@127.0.0.1:5432/giulia?serverVersion=18&charset=utf8"
###< Base de données PostgreSQL ###

###> Serveur SMTP — e-mails applicatifs (envoi synchrone) ###
#   Format : smtp://UTILISATEUR:MOTDEPASSE@HOTE:PORT
#     - port 587 = STARTTLS (recommandé) · 465 = TLS implicite
#     - encoder les caractères spéciaux du login/mot de passe :
#       @ → %40 · : → %3A · / → %2F · # → %23 · $ → %24 · espace → %20
#   Exemple : smtp://hello%40giulia-pizza-gorges.fr:m0tDeP%40sse@ssl0.ovh.net:587
MAILER_DSN=smtp://UTILISATEUR:MOTDEPASSE@HOTE:587

# Adresses e-mail du formulaire de contact.
# CONTACT_FROM_EMAIL doit correspondre au compte SMTP authentifié ci-dessus :
# OVH rejette les envois dont l'expéditeur ne lui appartient pas.
CONTACT_FROM_EMAIL=hello@giulia-pizza-gorges.fr
CONTACT_TO_EMAIL=hello@giulia-pizza-gorges.fr

# Google Analytics 4 — laisser vide/commenté pour désactiver le suivi
#GA_MEASUREMENT_ID=G-XXXXXXXXXX

###> symfony/routing ###
# URL absolue du site en production.
# Sert à générer le sitemap, les balises canonical et Open Graph (URLs absolues).
DEFAULT_URI=https://giulia-pizza-gorges.fr
###< symfony/routing ###
