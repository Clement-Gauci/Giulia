{# Écran de blocage. Le compte à rebours est indicatif : la pause est tenue
   côté serveur par le journal des tentatives, pas par cette page. #}
{% set seconds = feedback.secondsLeft(now) %}

<div class="blocked" data-controller="countdown" data-countdown-seconds-value="{{ seconds }}">
    <div class="blocked__icon">
        <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="#a24b32" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
    </div>

    <h2 class="blocked__title">Accès temporairement bloqué</h2>
    <p class="blocked__lead">{{ feedback.blockedReason }} Par sécurité, on met la connexion en pause.</p>

    <div class="blocked__box">
        <div class="blocked__label">Réessayez dans</div>
        <div class="blocked__clock" data-countdown-target="clock">{{ '%02d:%02d'|format(seconds // 60, seconds % 60) }}</div>
    </div>

    <div class="blocked__actions">
        <a class="btn btn--ghost" href="{{ path('admin_login_change') }}" data-countdown-target="retry" hidden>
            Réessayer maintenant
        </a>
        <a class="btn" href="tel:{{ establishment().phoneHref }}">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#d3a273" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Appeler la pizzeria
        </a>
    </div>
</div>
