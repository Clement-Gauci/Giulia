{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <main class="shell">
        <div class="shell__head">
            <h1 class="shell__title">Bonjour {{ app.user.name }}</h1>
            <a class="link-plain" href="{{ path('admin_logout') }}">Se déconnecter</a>
        </div>

        <div class="shell__card">
            <p>
                L'authentification est en place : vous êtes connecté avec le rôle
                <strong>{{ app.user.role.value == 'manager' ? 'gérant' : 'boutique' }}</strong>.
            </p>
            <p>
                Les écrans de gestion — carte des pizzas, horaires, congés, pizza du
                moment — sont le chantier suivant. Cette page n'existe pour l'instant
                que pour donner une destination à la connexion.
            </p>
        </div>
    </main>
{% endblock %}
