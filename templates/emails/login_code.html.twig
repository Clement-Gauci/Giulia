{# =========================================================================
   GABARIT PROVISOIRE — le design final est en cours dans Claude Design.
   Les variables ci-dessous sont figées : `code`, `account`, `expires_at`,
   `expires_in_minutes`, plus la fonction `establishment()`. Le nouveau design
   peut donc remplacer ce fichier sans toucher au PHP.
   ========================================================================= #}
{% set e = establishment() %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4ede0;padding:32px 16px;font-family:'DM Sans',Helvetica,Arial,sans-serif;color:#2a3138;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background:#fffdf8;border:1px solid #e7ddca;border-radius:20px;padding:28px;">
                <tr>
                    <td style="font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#a08d72;padding-bottom:8px;">
                        Espace pizzeria
                    </td>
                </tr>
                <tr>
                    <td style="font-size:22px;font-weight:800;letter-spacing:-.5px;padding-bottom:10px;">
                        Votre code de connexion
                    </td>
                </tr>
                <tr>
                    <td style="font-size:14px;line-height:1.6;color:#6b6459;padding-bottom:20px;">
                        Bonjour {{ account.name }}, voici le code à saisir pour ouvrir le dashboard.
                        Il est valable {{ expires_in_minutes }}&nbsp;minutes, soit jusqu'à
                        {{ expires_at|date('H:i') }}.
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding-bottom:20px;">
                        <div style="display:inline-block;background:#fbf6ec;border:1px solid #e7ddca;border-radius:16px;padding:16px 28px;font-size:34px;font-weight:800;letter-spacing:8px;color:#2a3138;">
                            {{ code }}
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="font-size:12.5px;line-height:1.55;color:#8a8377;background:#f7f1e6;border:1px solid #ece2cf;border-radius:13px;padding:11px 13px;">
                        Vous n'avez pas demandé ce code&nbsp;? Ignorez cet e-mail : sans lui,
                        personne ne peut entrer. En cas de doute, appelez la pizzeria au
                        {{ e.phone }}.
                    </td>
                </tr>
                <tr>
                    <td style="padding-top:20px;font-size:12px;color:#a59b88;">
                        {{ e.name }} — {{ e.address }}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
