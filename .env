# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Laissé vide ici (fichier commité) : la vraie valeur va dans .env.local.
# Elle signe les jetons CSRF et les cookies « rester connecté ».
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Connexion PostgreSQL — format :
#   postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE?serverVersion=XX&charset=utf8
#   - `serverVersion` doit refléter le serveur réellement utilisé : DBAL s'en sert
#     pour adapter le SQL qu'il génère (18 = PostgreSQL 18.x).
#   - encoder les caractères spéciaux du mot de passe : @ → %40 · # → %23 ·
#     : → %3A · / → %2F · $ → %24
# En environnement de test, config/packages/doctrine.yaml suffixe automatiquement
# le nom de la base (« giulia_test ») : rien à surcharger dans .env.test.
# Ci-dessous un défaut SANS secret ; le DSN réel va dans .env.local.
DATABASE_URL="postgresql://giulia:!ChangeMe!@127.0.0.1:5432/giulia?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Transports déclarés mais non utilisés : aucun message n'est routé vers `async`
# (voir config/packages/messenger.yaml). Les e-mails partent en synchrone.
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Envoi des e-mails — SYNCHRONE (aucun worker Messenger à faire tourner).
# Ne JAMAIS mettre d'identifiants réels ici (fichier commité) : les renseigner dans .env.local.
#   Format SMTP : smtp://UTILISATEUR:MOTDEPASSE@HOTE:PORT
#   - port 587 = STARTTLS (recommandé) · 465 = TLS implicite
#   - encoder les caractères spéciaux du login/mot de passe (@ → %40, etc.)
#   Exemple : smtp://contact%40giulia-pizza-gorges.fr:motdepasse@ssl0.ovh.net:587
# Défaut (dev/CI) : les e-mails ne sont pas réellement envoyés, mais le profiler
# Symfony affiche leur contenu complet.
MAILER_DSN=null://null
###< symfony/mailer ###
# Expéditeur des e-mails applicatifs. OVH rejette un expéditeur qui ne correspond
# pas au compte SMTP authentifié : garder l'adresse de ce compte.
CONTACT_FROM_EMAIL=hello@giulia-pizza-gorges.fr
CONTACT_TO_EMAIL=hello@giulia-pizza-gorges.fr

###> giulia/analytics ###
# Identifiant Google Analytics 4 (G-XXXXXXXXXX). Vide = analytics totalement désactivé.
GA_MEASUREMENT_ID=
###< giulia/analytics ###
