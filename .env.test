# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
GA_MEASUREMENT_ID=G-TEST00000

# Base de données de test
#   Le nom de la base reçoit automatiquement le suffixe « _test »
#   (config/packages/doctrine.yaml) : un DSN pointant sur « giulia » cible donc
#   « giulia_test ». Création de la base :
#     php bin/console doctrine:database:create --env=test
#
#   ATTENTION : .env.local N'EST PAS chargé en environnement de test — Symfony
#   l'ignore volontairement. Le DSN réel (avec mot de passe) doit donc être
#   dupliqué dans .env.test.local, non commité (règle /.env.*.local du .gitignore).
